# =========================================================
# الهدف: بناء نظام OpenWrt كجسر شفاف لجهاز ZTE E8820V2
# =========================================================

# 1. تحديد الهدف (Target) والجهاز (Device)
CONFIG_TARGET_ramips=y
CONFIG_TARGET_ramips_mt7621=y
CONFIG_TARGET_ramips_mt7621_DEVICE_zte_e8820v2=y

# 2. إزالة جميع الحزم غير الضرورية لتقليل الحجم
# (هذه هي الحزم التي يجب أن تكون معطلة)
# CONFIG_PACKAGE_dnsmasq is not set
# CONFIG_PACKAGE_dnsmasq-full is not set
# CONFIG_PACKAGE_firewall is not set
# CONFIG_PACKAGE_firewall4 is not set
# CONFIG_PACKAGE_odhcpd-ipv6only is not set
# CONFIG_PACKAGE_odhcp6c is not set
# CONFIG_PACKAGE_luci-app-firewall is not set
# CONFIG_PACKAGE_luci-app-dhcp is not set
# CONFIG_PACKAGE_luci-ssl is not set
# CONFIG_PACKAGE_wpad-full is not set

# 3. إضافة الحزم المطلوبة لعمل الجسر الشفاف
# أداة إدارة الجسور (Bridge)
CONFIG_PACKAGE_bridge-utils=y
# دعم الجسر في نواة لينكس (Kernel)
CONFIG_PACKAGE_kmod-bridge=y
# واجهة LuCI للتحكم في الجسور
CONFIG_PACKAGE_luci-app-bridge=y
# حزمة المصادقة اللاسلكية الأساسية (لضمان عمل الواي فاي كـ AP أو Client)
CONFIG_PACKAGE_wpad-basic=y
# واجهة الويب الأساسية (LuCI)
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-base=y
CONFIG_PACKAGE_luci-mod-admin-full=y
# تعريفات الواي فاي للجهاز (2.4GHz و 5GHz)
CONFIG_PACKAGE_kmod-mt7603=y
CONFIG_PACKAGE_kmod-mt76x2=y
# تعريف USB (اختياري، لكنه مفيد)
CONFIG_PACKAGE_kmod-usb2=y
